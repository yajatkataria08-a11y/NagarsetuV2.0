# NagarSetu V2.0 — Environment Configuration Template
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# AI Engine Microservice
AI_SERVICE_URL=http://127.0.0.1:8000
# PYTHON_BIN=python3 # Optional: overrides automatic Python detection

# Security & RBAC
DISABLE_AUTH=true
JWT_SECRET=nagarsetu_dev_secret_change_in_production

# Optional Cloud PostGIS (Supabase)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-key

# Optional Twilio SMS Integration
# TWILIO_ACCOUNT_SID=your_account_sid
# TWILIO_AUTH_TOKEN=your_auth_token
# TWILIO_PHONE_NUMBER=+1234567890

# Optional Google Gemini Multimodal API Key
# GEMINI_API_KEY=your_gemini_api_key

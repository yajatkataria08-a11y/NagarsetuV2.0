# NagarSetu V2 — Frontend Environment Variables
# Copy this file to .env.local and fill in values

# Backend API WebSocket URL (leave blank to use mock data in dev)
NEXT_PUBLIC_API_URL=http://localhost:4000

# Supabase (for future direct client calls)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# NagarSetu V2.0 — Backend Environment Configuration Template
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000
AI_SERVICE_URL=http://127.0.0.1:8000

# Authentication & RBAC Configuration
# Set to 'false' by default to enforce JWT bearer token validation and role access checks.
# Set to 'true' ONLY in isolated demo environments if running without login.
DISABLE_AUTH=false
JWT_SECRET=generate_a_cryptographically_secure_random_secret_for_production
SENSOR_API_KEY=generate_a_secure_sensor_ingest_key_for_iot_devices

# Live CCTV Stream Feeds (HLS .m3u8 / RTSP)
CAM001_URL="https://cph-p2p-msl.akamaized.net/hls/live/200034/test/master.m3u8"
CAM002_URL="https://fl2.movemedia.tv/fastcat/fastcat1/chunklist_w1530962804.m3u8"
CAM003_URL="http://192.168.1.15:8080/video"

# Optional Microservice & Cloud Integrations
# PYTHON_BIN=python3
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-key
# TWILIO_ACCOUNT_SID=your_account_sid
